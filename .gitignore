# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.local contains secrets, never commit it
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# .env.example is intentionally committed — it documents required variables

# vercel
.vercel

# vendored skill content — restored from skills-lock.json, not source
/.agents/
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
