# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Alternate build dirs from NEXT_DIST_DIR — see scripts/verify/README.md, which
# builds production into one of these so it can be served alongside `next dev`.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.local contains secrets, never commit it
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# .env.example is intentionally committed — it documents required variables

# vercel
.vercel

# vendored skill content — restored from skills-lock.json, not source
/.agents/
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI local state
supabase/.temp/

# Seeded demo session token — never commit. Was written by
# scripts/verify/seed-demo.mjs, removed with the seasons/events/brochure
# track (supabase/migrations/036_remove_events_brochure_seasons.sql); kept
# ignored in case a future seeder writes the same filename.
scripts/verify/.demo-cookie.js
scripts/verify/.probe.mjs

# Customer-supplied facility documents (Commonwealth, Crystal Pool). Shared
# for context only — real operational documents from City of Victoria, never
# ours to redistribute. Read them locally; they stay out of the repo.
*.xlsx
Pool Layout Map with depths.pdf

# Verification-harness artifacts.
#
# verify-ad, verify-ag and verify-aj default `--out=` to "." (the repo root),
# so running any of them drops PDFs and PNGs next to package.json. They are
# evidence from one run against one throwaway fixture, not source — re-run the
# harness to regenerate. The --shots= harnesses (aa, ac, q, z) write nothing
# unless you pass a directory, so they need no entry here.
#
# Anchored with a leading slash on purpose: an unanchored *.pdf would also
# shadow "SCP Lengths Schedule Aug 10-16.pdf", which IS tracked.
/verify-*.png
/verify-*.pdf
/zones-desktop.png
/zones-mobile.png
