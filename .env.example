# =============================================================================
# DROPIN — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
#
# Variables prefixed NEXT_PUBLIC_ are safe to expose to the browser.
# All others are server-only — never import them in components or client hooks.
# =============================================================================

# --- Supabase ---
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (safe for browser — replaces the older ANON_KEY name)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Server-only. Bypasses Row Level Security. Never expose to browser.
# Found in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Stripe ---
# Found in: Stripe Dashboard → Developers → API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Found in: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs for subscription tiers (create in Stripe Dashboard → Products)
STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly_id
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_your_enterprise_monthly_id

# --- Mapbox ---
# Found in: https://account.mapbox.com → Access Tokens
# Restrict this token to your domain in production.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91cnVzZXJuYW1lIiwiYSI6InlvdXJ0b2tlbiJ9.your_token_here

# --- Resend (email) ---
# Found in: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@dropin.app

# --- Scraping Service ---
# URL of the external Playwright scraping service (hosted on Railway/Fly.io)
SCRAPER_SERVICE_URL=https://your-scraper-service.railway.app

# Shared secret used to authenticate webhook calls FROM the scraper service.
# Generate with: openssl rand -hex 32
SCRAPER_SERVICE_SECRET=your_32_byte_hex_secret_here

# --- Analytics ---
# Random salt for IP hashing in analytics events (SHA-256 of ip + daily_salt).
# Rotate periodically. Generate with: openssl rand -hex 32
ANALYTICS_IP_SALT=your_32_byte_hex_salt_here

# --- App ---
# The public URL of this app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
